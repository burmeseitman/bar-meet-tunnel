# Generate independent tokens using: openssl rand -hex 32
CONTROL_TOKEN=<generate-admin-token>
AGENT_TOKENS={"my-awesome-app":"<generate-agent-token>"}
REQUEST_TIMEOUT_SECONDS=60

# metadata stores redacted headers but no bodies/query strings; replay requires full.
CAPTURE_MODE=metadata
CAPTURE_TTL=15m
# Additional header names to redact from stored metadata and inspector output.
REDACT_HEADERS=X-Auth-Token,X-Session-Token
